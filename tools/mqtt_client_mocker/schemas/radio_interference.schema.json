{
"$schema": "http://json-schema.org/draft-07/schema#",
"title": "Radio Interference Description File",
"type": "object",
"required": [
    "radios",
    "metadata",
    "global_settings",
    "interference_sources"
],
"properties": {
    "metadata": {
        "type": "object",
        "required": ["version", "scenario_name", "created_utc"],
        "properties": {
            "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+$",
                "description": "Schema version"
            },
            "scenario_name": {
                "type": "string",
                "minLength": 1
            },
            "description": {
                "type": "string"
            },
            "created_utc": {
                "type": "string",
                "format": "date-time"
            },
            "author": {
                "type": "string"
            }
        }
    },
    "global_settings": {
        "type": "object",
        "required": [
            "duration_s"
        ],
        "properties": {
            "duration_s": {
                "type": "number",
                "minimum": 0.001
            }
        }
    },
    "radios": {
        "type": "array",
        "minItems": 1,
        "items": {
            "type": "object",
            "required": [
                "radio_id",
                "type",
                "center_frequency_hz",
                "sample_rate_hz"
            ],
            "properties": {
                "radio_id": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": ["transmitter", "receiver"]
                },
                "center_frequency_hz": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 6e9,
                    "description": "RF center frequency in Hz"
                },
                "sample_rate_hz": {
                    "type": "number",
                    "minimum": 1e3,
                    "maximum": 50e6
                },
                "gain_db": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100,
                    "default": 0
                }
            }
        }
    },
    "interference_sources": {
        "type": "array",
        "minItems": 1,
        "items": {
            "type": "object",
            "required": [
            "radio_id",
            "type",
            "power_dbm",
            "start_time_s",
            "end_time_s"
            ],
            "properties": {
                "radio_id": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                    "cw_jammer",
                    "noise_jammer",
                    "chirp_jammer",
                    "gnss_spoofer"
                    ]
                },
                "power_dbm": {
                    "type": "number",
                    "minimum": -150,
                    "maximum": 60
                },
                "start_time_s": {
                    "type": "number",
                    "minimum": 0
                },
                "end_time_s": {
                    "type": "number",
                    "minimum": 0
                },
                "center_frequency_hz": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 6e9,
                    "description": "RF center frequency in Hz"
                },
                "modulation": {
                    "type": "string",
                    "enum": [
                    "none",
                    "fm",
                    "am"
                    ],
                    "default": "none"
                },
                "parameters": {
                    "type": "object",
                    "properties": {
                        "span_hz": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 56e6
                        },
                        "sweep_time_s": {
                            "type": "number",
                            "minimum": 0.0001
                        },
                        "constellation": {
                            "type": "string",
                            "enum": ["GPS", "GLONASS", "GALILEO", "BEIDOU"]
                        },
                        "prn_list": {
                            "type": "array",
                            "items": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 210
                            }
                        },
                        "trajectory": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "t",
                                    "latitude_deg",
                                    "longitude_deg",
                                    "altitude_m"
                                ],
                                "properties": {
                                    "t": {
                                        "type": "number"
                                    },
                                    "latitude_deg": {
                                        "type": "number",
                                        "minimum": -90,
                                        "maximum": 90,
                                        "description": "Latitude in degrees (WGS84)"
                                    },
                                    "longitude_deg": {
                                        "type": "number",
                                        "minimum": -180,
                                        "maximum": 180,
                                        "description": "Longitude in degrees (WGS84)"
                                    },
                                    "altitude_m": {
                                        "type": "number",
                                        "description": "Altitude above mean sea level in meters"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}