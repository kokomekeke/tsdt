option(
    'devenv_paths',
    type: 'array',
    value: [],
    description: 'Extra paths to add to PATH in devenv'
)

option(
    'build_scg',
    type: 'boolean',
    value: true,
    description: 'Build scg.exe'
)

option(
    'build_scgserver',
    type: 'boolean',
    value: true,
    description: 'Build scgserver.exe'
)

option(
    'build_scg_lint',
    type: 'boolean',
    value: true,
    description: 'Build scglint.exe, a hardware-free json validation utility'
)

option(
    'have_ssp',
    type: 'boolean',
    value: true,
    description: 'Build with the ssp gnss engine. Without it a spoofer can only be mocked'
)
