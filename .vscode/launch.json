{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug scg (MSVC)",
            "cwd": "${workspaceFolder}/build-msvc/",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-msvc/scg.exe",
            "args": [
                "-r",
                "../scenarios/test-1.json",
                "recording_test1"
            ],
            // "envFile": "${workspaceFolder}/build-msvc/.env",
            "stopAtEntry": false,
            "environment": [],
            "envFile": "${workspaceFolder}/build-msvc/subprojects/SSG/.env",
            "console": "internalConsole",
        },
        {
            "name": "Debug scgserver (MSVC)",
            "cwd": "${workspaceFolder}/build-msvc/",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-msvc/scgserver.exe",
            "args": [
                "..\\sisiconfig\\config-1.json"
            ],
            // "envFile": "${workspaceFolder}/build-msvc/.env",
            "stopAtEntry": false,
            "environment": [],
            "envFile": "${workspaceFolder}/build-msvc/subprojects/SSG/.env",
            "console": "internalConsole",
        },
        {
            "name": "Attach (MSVC)",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
        },
        {
            "name": "Attach (LLDB)",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
        },

    ]
}